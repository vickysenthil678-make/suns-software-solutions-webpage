# Server Configuration
PORT=5000
NODE_ENV=development

# Email Configuration (Gmail with App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Admin Email (where notifications are sent)
ADMIN_EMAIL=admin@sunsoftware.co.in

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database Configuration (optional - for future MongoDB integration)
# MONGODB_URI=mongodb://localhost:27017/sun-software
# DATABASE_NAME=sun-software

# API Keys (optional - for future third-party integrations)
# SENDGRID_API_KEY=your-sendgrid-key
# STRIPE_API_KEY=your-stripe-key

# Logging
LOG_LEVEL=debug
